<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Uni Buy & Sell' %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <%- include('../partials/nav') %>
  <main class="container">
    <%- include('../partials/flash') %>
    <div style="max-width: 480px; margin: 2rem auto;">
      <h1>Forgot Password</h1>
      <p style="color: var(--text-muted); margin: 0.5rem 0 1.5rem;">
        Enter your email address and we'll send you a link to reset your password.
      </p>
      <form method="POST" action="/forgot-password">
        <%- include('../partials/csrf') %>
        <label for="email">Email Address</label>
        <input id="email" type="email" name="email" placeholder="you@university.edu" required>

        <button class="btn btn-primary" type="submit" style="margin-top: 1rem; width: 100%;">Send Reset Link</button>
      </form>
      <p style="margin-top: 1.5rem; text-align: center;">
        Remember your password? <a href="/login">Login</a>
      </p>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
