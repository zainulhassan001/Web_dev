<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Uni Buy & Sell' %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <%- include('../partials/nav') %>
  <main class="container">
    <%- include('../partials/flash') %>
    <div style="max-width: 480px; margin: 2rem auto;">
      <h1>Reset Password</h1>
      <p style="color: var(--text-muted); margin: 0.5rem 0 1.5rem;">
        Enter your new password below.
      </p>
      <form method="POST" action="/reset-password/<%= token %>">
        <%- include('../partials/csrf') %>
        <label for="password">New Password</label>
        <input id="password" type="password" name="password" minlength="6" required>
        <small class="form-hint">At least 6 characters</small>

        <label for="confirmPassword">Confirm New Password</label>
        <input id="confirmPassword" type="password" name="confirmPassword" minlength="6" required>

        <button class="btn btn-primary" type="submit" style="margin-top: 1rem; width: 100%;">Reset Password</button>
      </form>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
