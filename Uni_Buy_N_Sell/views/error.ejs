<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Uni Buy & Sell' %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <%- include('partials/flash') %>
    <div class="card" style="padding: 2rem; text-align: center; margin-top: 2rem;">
      <h1>Error <%= code %></h1>
      <p style="margin-top: 0.5rem; color: var(--text-muted);"><%= message %></p>
      <a class="btn btn-primary" href="/" style="margin-top: 1rem;">Back to Home</a>
    </div>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
