<nav>
  <div class="navbar container">
    <a class="logo" href="/" style="display: flex; align-items: center; gap: 0.5rem;">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <!-- Graduation Cap -->
        <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
        <path d="M6 12v5c0 2 2.5 3 6 3s6-1 6-3v-5"/>
      </svg>
      Uni Buy & Sell
    </a>
    <button class="hamburger" id="hamburgerBtn" aria-label="Toggle navigation" aria-expanded="false">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
    <div class="nav-links">
      <a href="/ads/onsale-products" style="color: var(--primary); font-weight: bold;">
        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg></span>On Sale
      </a>
      <a href="/ads"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg></span>Browse</a>
      <% if (currentUser) { %>
        <div class="notif-wrap">
          <button class="notif-btn" id="notifBtn" aria-label="Notifications">
            <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 10-12 0c0 7-3 7-3 7h18s-3 0-3-7" /><path d="M13.73 21a2 2 0 01-3.46 0" /></svg></span>
            Notifications
            <% if (notificationCount > 0) { %><span class="badge"><%= notificationCount %></span><% } %>
          </button>
          <div class="notif-menu" id="notifMenu">
            <div class="notif-head">
              <strong>Notifications</strong>
              <a href="/notifications">View all</a>
            </div>
            <% if (notifications && notifications.length) { %>
              <% notifications.forEach(note => { %>
                <a class="notif-item <%= note.isRead ? '' : 'unread' %>" href="<%= note.link || '/notifications' %>">
                  <div><strong><%= note.title %></strong></div>
                  <% if (note.body) { %><div class="ad-meta"><%= note.body %></div><% } %>
                </a>
              <% }) %>
            <% } else { %>
              <div class="notif-empty">No notifications</div>
            <% } %>
          </div>
        </div>
        <a href="/messages"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a4 4 0 01-4 4H7l-4 4V7a4 4 0 014-4h10a4 4 0 014 4z" /></svg></span>Messages <% if (unreadCount > 0) { %><span class="badge"><%= unreadCount %></span><% } %></a>
        <a href="/user/liked-ads"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" /></svg></span>Saved</a>
        <a href="/user/my-ads"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v6a2 2 0 01-2 2H6a2 2 0 01-2-2v-6" /><path d="M12 12v9" /><path d="M5 7l7-4 7 4" /><path d="M5 7h14" /></svg></span>My Ads</a>
        <a href="/ads/post"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><line x1="12" y1="8" x2="12" y2="16" /><line x1="8" y1="12" x2="16" y2="12" /></svg></span>Post Ad</a>
        <a href="/profile"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21a8 8 0 00-16 0" /><circle cx="12" cy="7" r="4" /></svg></span><%= currentUser.name %></a>
        <% if (currentUser.role === 'admin') { %><a href="/admin"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 4v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V7l7-4z" /></svg></span>Admin</a><% } %>
        <a href="/logout"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg></span>Logout</a>
      <% } else { %>
        <a href="/login"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4" /><polyline points="10 17 15 12 10 7" /><line x1="15" y1="12" x2="3" y2="12" /></svg></span>Login</a>
        <a href="/register"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21a8 8 0 00-16 0" /><circle cx="12" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="16" y1="11" x2="22" y2="11" /></svg></span>Register</a>
      <% } %>
    </div>
  </div>
</nav>
